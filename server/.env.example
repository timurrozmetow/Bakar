# MySQL connection string used by Prisma
DATABASE_URL="mysql://root:password@localhost:3306/bakar"

# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# First admin (created by `npm run db:seed`)
ADMIN_EMAIL="admin@bakar.tm"
ADMIN_PASSWORD="admin12345"
ADMIN_NAME="Администратор"

# Where the public site runs (for CORS)
CLIENT_ORIGIN="http://localhost:5173"

# Public base URL of this API (used to build absolute upload URLs). Leave empty to use relative /uploads.
PUBLIC_URL=""

# Public site URL (used for sitemap.xml / robots.txt absolute links)
PUBLIC_SITE_URL=""

# ── Notifications about new partner requests (both optional) ──
# Telegram: create a bot via @BotFather, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# E-mail (SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
NOTIFY_EMAIL_TO=""
NOTIFY_EMAIL_FROM=""
