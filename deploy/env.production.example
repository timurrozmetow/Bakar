# Production .env for bakar-seeds.com — copy to /var/www/bakar/server/.env
# chmod 600 server/.env  (it holds DB and JWT secrets)

NODE_ENV=production
HOST=127.0.0.1
PORT=4000

# MySQL on the same host. Use a dedicated user, NOT root.
DATABASE_URL="mysql://bakar:СИЛЬНЫЙ_ПАРОЛЬ_БД@localhost:3306/bakar"

# Generate once:  openssl rand -hex 48
JWT_SECRET="ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_96_СИМВОЛОВ"
JWT_EXPIRES_IN="7d"

# Site origin — used for CORS and for absolute links in sitemap.xml / robots.txt
CLIENT_ORIGIN="https://bakar-seeds.com"
PUBLIC_SITE_URL="https://bakar-seeds.com"
PUBLIC_URL="https://bakar-seeds.com"

# First admin, created by `npm run db:seed`. Change the password right after
# the first login (в админке: Профиль → Смена пароля), then these values no longer matter.
ADMIN_EMAIL="admin@bakar-seeds.com"
ADMIN_PASSWORD="ЗАМЕНИТЕ_ПЕРЕД_СИДОМ"
ADMIN_NAME="Администратор"

# ── Уведомления о заявках (необязательно) ──
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
NOTIFY_EMAIL_TO=""
NOTIFY_EMAIL_FROM=""
